# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
# LeadConnector chat widget ID. Leave empty to disable the chat bubble.
NEXT_PUBLIC_LC_CHAT_WIDGET_ID=
# Set to 1 on a preview deployment to show CONFIRM badges outside development.
NEXT_PUBLIC_SHOW_TODOS=
# Instagram feed — set ONE (see lib/instagram.ts). Without either, the section
# shows the site's portfolio photos linking to the Instagram profile.
# Recommended: JSON feed URL from a feed service such as Behold.so (handles token renewal)
INSTAGRAM_FEED_URL=
# Or: Instagram API with Instagram Login long-lived token (expires every 60 days)
INSTAGRAM_ACCESS_TOKEN=
